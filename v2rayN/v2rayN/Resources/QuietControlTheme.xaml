<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Compact Fluent-inspired surface tokens. ThemeSettingViewModel changes these
         resources together, so the custom shell follows every built-in theme. -->
    <Color x:Key="QccCanvasColor">#FFF6F7F9</Color>
    <Color x:Key="QccSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="QccSurfaceRaisedColor">#FFFBFCFE</Color>
    <Color x:Key="QccBorderColor">#FFE1E5EC</Color>
    <Color x:Key="QccTextColor">#FF172033</Color>
    <Color x:Key="QccMutedColor">#FF667085</Color>
    <Color x:Key="QccPrimaryColor">#FF2563EB</Color>
    <Color x:Key="QccPrimarySoftColor">#FFE8F0FF</Color>
    <Color x:Key="QccHoverColor">#FFF0F3F8</Color>
    <Color x:Key="QccSuccessColor">#FF16A34A</Color>
    <Color x:Key="QccWarningColor">#FFF59E0B</Color>
    <Color x:Key="QccDangerColor">#FFDC2626</Color>

    <SolidColorBrush x:Key="QccCanvas" Color="{DynamicResource QccCanvasColor}" />
    <SolidColorBrush x:Key="QccSurface" Color="{DynamicResource QccSurfaceColor}" />
    <SolidColorBrush x:Key="QccSurfaceRaised" Color="{DynamicResource QccSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="QccBorder" Color="{DynamicResource QccBorderColor}" />
    <SolidColorBrush x:Key="QccText" Color="{DynamicResource QccTextColor}" />
    <SolidColorBrush x:Key="QccMuted" Color="{DynamicResource QccMutedColor}" />
    <SolidColorBrush x:Key="QccPrimary" Color="{DynamicResource QccPrimaryColor}" />
    <SolidColorBrush x:Key="QccPrimarySoft" Color="{DynamicResource QccPrimarySoftColor}" />
    <SolidColorBrush x:Key="QccHover" Color="{DynamicResource QccHoverColor}" />
    <SolidColorBrush x:Key="QccSuccess" Color="{DynamicResource QccSuccessColor}" />
    <SolidColorBrush x:Key="QccWarning" Color="{DynamicResource QccWarningColor}" />
    <SolidColorBrush x:Key="QccDanger" Color="{DynamicResource QccDangerColor}" />

    <FontFamily x:Key="QccFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="QccDisplayFont">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>

    <!-- MainWindow replaces these local dynamic resources in 0.05 scale steps.
         Quantized changes keep text crisp and avoid a full remeasure for every
         pixel while the user drags the window edge. -->
    <system:Double x:Key="QccFontTiny">10.5</system:Double>
    <system:Double x:Key="QccFontSmall">11</system:Double>
    <system:Double x:Key="QccFontBody">12</system:Double>
    <system:Double x:Key="QccFontStrong">13</system:Double>
    <system:Double x:Key="QccFontTitle">14</system:Double>
    <system:Double x:Key="QccFontHero">16</system:Double>
    <system:Double x:Key="QccFontLarge">18</system:Double>
    <system:Double x:Key="QccLineTitle">17</system:Double>
    <system:Double x:Key="QccLineHero">19</system:Double>

    <Style x:Key="QccWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource QccCanvas}" />
        <Setter Property="Foreground" Value="{StaticResource QccText}" />
        <Setter Property="FontFamily" Value="{StaticResource QccFont}" />
        <Setter Property="FontSize" Value="{DynamicResource QccFontStrong}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>

    <Style x:Key="QccHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QccDisplayFont}" />
        <Setter Property="Foreground" Value="{StaticResource QccText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="QccMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource QccMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource QccFontBody}" />
    </Style>

    <Style x:Key="QccPrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource QccPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource QccPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource QccFontBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="QccCompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource QccPrimaryButton}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="{DynamicResource QccFontBody}" />
    </Style>

    <Style x:Key="QccSecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{StaticResource QccText}" />
        <Setter Property="Background" Value="{StaticResource QccSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource QccBorder}" />
        <Setter Property="FontSize" Value="{DynamicResource QccFontBody}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="QccNavButton" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{StaticResource QccText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource QccFontStrong}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavSurface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{StaticResource QccHover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{StaticResource QccPrimarySoft}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QccNavButtonActive" TargetType="Button" BasedOn="{StaticResource QccNavButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource QccPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="QccIconButton" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource QccMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="IconSurface" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconSurface" Property="Background" Value="{StaticResource QccHover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="IconSurface" Property="Background" Value="{StaticResource QccPrimarySoft}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Avoid bitmap shadows on surfaces refreshed once per second. -->
    <Style x:Key="QccCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource QccSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource QccBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="QccDivider" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource QccBorder}" />
        <Setter Property="Margin" Value="0" />
    </Style>
</ResourceDictionary>
