<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="QccCanvasColor">#FFF8FAFC</Color>
    <Color x:Key="QccSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="QccBorderColor">#FFE5EAF0</Color>
    <Color x:Key="QccTextColor">#FF172033</Color>
    <Color x:Key="QccMutedColor">#FF667085</Color>
    <Color x:Key="QccPrimaryColor">#FF1677FF</Color>
    <Color x:Key="QccPrimarySoftColor">#FFE8F2FF</Color>
    <Color x:Key="QccSuccessColor">#FF16A34A</Color>
    <Color x:Key="QccWarningColor">#FFF59E0B</Color>
    <Color x:Key="QccDangerColor">#FFDC2626</Color>

    <SolidColorBrush x:Key="QccCanvas" Color="{StaticResource QccCanvasColor}" />
    <SolidColorBrush x:Key="QccSurface" Color="{StaticResource QccSurfaceColor}" />
    <SolidColorBrush x:Key="QccBorder" Color="{StaticResource QccBorderColor}" />
    <SolidColorBrush x:Key="QccText" Color="{StaticResource QccTextColor}" />
    <SolidColorBrush x:Key="QccMuted" Color="{StaticResource QccMutedColor}" />
    <SolidColorBrush x:Key="QccPrimary" Color="{StaticResource QccPrimaryColor}" />
    <SolidColorBrush x:Key="QccPrimarySoft" Color="{StaticResource QccPrimarySoftColor}" />
    <SolidColorBrush x:Key="QccSuccess" Color="{StaticResource QccSuccessColor}" />
    <SolidColorBrush x:Key="QccWarning" Color="{StaticResource QccWarningColor}" />
    <SolidColorBrush x:Key="QccDanger" Color="{StaticResource QccDangerColor}" />

    <FontFamily x:Key="QccFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="QccDisplayFont">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>

    <Style x:Key="QccWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource QccCanvas}" />
        <Setter Property="Foreground" Value="{StaticResource QccText}" />
        <Setter Property="FontFamily" Value="{StaticResource QccFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>

    <Style x:Key="QccHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QccDisplayFont}" />
        <Setter Property="Foreground" Value="{StaticResource QccText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="QccMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource QccMuted}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="QccPrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource QccPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource QccPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="QccCompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource QccPrimaryButton}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="QccSecondaryButton" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{StaticResource QccText}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource QccBorder}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="QccNavButton" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="10,2" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{StaticResource QccText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="QccNavButtonActive" TargetType="Button" BasedOn="{StaticResource QccNavButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource QccPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="QccIconButton" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource QccMuted}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="QccCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource QccSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource QccBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="QccDivider" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource QccBorder}" />
        <Setter Property="Margin" Value="0" />
    </Style>
</ResourceDictionary>
