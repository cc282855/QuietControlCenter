<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vms:StatusBarViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <Grid Background="{StaticResource QccSurface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource QccBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.55*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="0,0,10,0" BorderBrush="{StaticResource QccBorder}" BorderThickness="0,0,1,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource QccText}" FontSize="{DynamicResource QccFontStrong}" FontWeight="SemiBold" Text="系统代理" />
                        <ComboBox
                            x:Name="cmbSystemProxy"
                            Grid.Column="1"
                            Height="32"
                            Margin="8,0,0,0"
                            Padding="8,2"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuSystemproxy}"
                            FontSize="{DynamicResource QccFontBody}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyClear}" />
                            <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxySet}" />
                            <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                            <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyPac}" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Padding="10,0" BorderBrush="{StaticResource QccBorder}" BorderThickness="0,0,1,0">
                    <StackPanel x:Name="spEnableTun" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource QccText}" FontSize="{DynamicResource QccFontStrong}" FontWeight="SemiBold" Text="TUN 模式" />
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <ToggleButton
                                x:Name="togEnableTun"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Static resx:ResUI.TbEnableTunAs}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource QccMuted}" FontSize="{DynamicResource QccFontSmall}" Text="{x:Static resx:ResUI.TbEnableTunAs}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="10,0" BorderBrush="{StaticResource QccBorder}" BorderThickness="0,0,1,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource QccText}" FontSize="{DynamicResource QccFontStrong}" FontWeight="SemiBold" Text="路由模式" />
                        <ComboBox
                            x:Name="cmbRoutings2"
                            Grid.Column="1"
                            Height="32"
                            Margin="8,0,0,0"
                            Padding="8,2"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuRouting}"
                            DisplayMemberPath="Remarks"
                            FontSize="{DynamicResource QccFontBody}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                    </Grid>
                </Border>

                <Grid Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource QccText}" FontSize="{DynamicResource QccFontStrong}" FontWeight="SemiBold" Text="端口状态" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtInboundDisplay" Foreground="{StaticResource QccMuted}" FontSize="{DynamicResource QccFontSmall}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="txtInboundLanDisplay" Margin="0,2,0,0" Foreground="{StaticResource QccMuted}" FontSize="{DynamicResource QccFontSmall}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="txtSpeedProxyDisplay" />
                    <TextBlock x:Name="txtSpeedDirectDisplay" />
                    <TextBlock x:Name="txtRunningServerDisplay" />
                    <TextBlock x:Name="txtRunningInfoDisplay" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource QccSurfaceRaised}" BorderBrush="{StaticResource QccBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{StaticResource QccMuted}" />
                    <TextBlock x:Name="txtBottomRunningStatus" Foreground="{StaticResource QccMuted}" FontSize="{DynamicResource QccFontSmall}" Text="未连接" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource QccMuted}" FontSize="{DynamicResource QccFontSmall}" Text="{Binding InboundDisplay, StringFormat=本地：{0}, FallbackValue=本地：—}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource QccMuted}" FontSize="{DynamicResource QccFontSmall}" Text="{Binding SelectedRouting.Remarks, StringFormat=路由：{0}, FallbackValue=路由：—}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource QccMuted}" FontSize="{DynamicResource QccFontSmall}" Text="系统代理与 TUN 实时同步" />
            </Grid>
        </Border>

        <tb:TaskbarIcon
            x:Name="tbNotify"
            IconSource="/Resources/v2rayN.ico"
            NoLeftClickDelay="True"
            ToolTipText="v2rayN">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource DefContextMenu}">
                    <MenuItem
                        x:Name="menuSystemProxyClear"
                        Height="{StaticResource MenuItemHeight}"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuSystemProxyClear}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="menuSystemProxyClear2"
                                    Margin="{StaticResource MarginRight8}"
                                    VerticalAlignment="Center"
                                    Kind="Check" />
                                <TextBlock Text="{x:Static resx:ResUI.menuSystemProxyClear}" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem
                        x:Name="menuSystemProxySet"
                        Height="{StaticResource MenuItemHeight}"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuSystemProxySet}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="menuSystemProxySet2"
                                    Margin="{StaticResource MarginRight8}"
                                    VerticalAlignment="Center"
                                    Kind="Check" />
                                <TextBlock Text="{x:Static resx:ResUI.menuSystemProxySet}" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem
                        x:Name="menuSystemProxyNothing"
                        Height="{StaticResource MenuItemHeight}"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuSystemProxyNothing}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="menuSystemProxyNothing2"
                                    Margin="{StaticResource MarginRight8}"
                                    VerticalAlignment="Center"
                                    Kind="Check" />
                                <TextBlock Text="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem
                        x:Name="menuSystemProxyPac"
                        Height="{StaticResource MenuItemHeight}"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuSystemProxyPac}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="menuSystemProxyPac2"
                                    Margin="{StaticResource MarginRight8}"
                                    VerticalAlignment="Center"
                                    Kind="Check" />
                                <TextBlock Text="{x:Static resx:ResUI.menuSystemProxyPac}" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator x:Name="sepRoutings" />
                    <MenuItem
                        x:Name="menuRoutings"
                        Height="Auto"
                        AutomationProperties.Name="{x:Static resx:ResUI.menuRouting}">
                        <MenuItem.Header>
                            <DockPanel>
                                <ComboBox
                                    x:Name="cmbRoutings"
                                    MaxWidth="300"
                                    materialDesign:HintAssist.Hint="{x:Static resx:ResUI.menuRouting}"
                                    AutomationProperties.Name="{x:Static resx:ResUI.menuRouting}"
                                    DisplayMemberPath="Remarks"
                                    FontSize="{DynamicResource StdFontSize}"
                                    Style="{StaticResource MaterialDesignFilledComboBox}" />
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Height="Auto" AutomationProperties.Name="{x:Static resx:ResUI.menuServers}">
                        <MenuItem.Header>
                            <DockPanel>
                                <ComboBox
                                    x:Name="cmbServers"
                                    MaxWidth="300"
                                    materialDesign:HintAssist.Hint="{x:Static resx:ResUI.menuServers}"
                                    AutomationProperties.Name="{x:Static resx:ResUI.menuServers}"
                                    DisplayMemberPath="Text"
                                    FontSize="{DynamicResource StdFontSize}"
                                    Style="{StaticResource MaterialDesignFilledComboBox}" />
                            </DockPanel>
                        </MenuItem.Header>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        x:Name="menuAddServerViaClipboard2"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuAddServerViaClipboard}" />
                    <MenuItem
                        x:Name="menuAddServerViaScan2"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuAddServerViaScan}" />
                    <MenuItem
                        x:Name="menuSubUpdate2"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuSubUpdate}" />
                    <MenuItem
                        x:Name="menuSubUpdateViaProxy2"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                    <Separator />
                    <MenuItem
                        x:Name="menuCopyProxyCmdToClipboard"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuCopyProxyCmdToClipboard}" />
                    <Separator />
                    <MenuItem
                        x:Name="menuExit"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuExit}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</reactiveui:ReactiveUserControl>
