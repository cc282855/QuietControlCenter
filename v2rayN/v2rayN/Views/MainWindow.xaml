<base:WindowBase
    x:Class="v2rayN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="米卡"
    Width="1440"
    Height="960"
    MinWidth="1120"
    MinHeight="720"
    x:TypeArguments="vms:MainWindowViewModel"
    Icon="/Resources/v2rayN.ico"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    Style="{StaticResource QccWindow}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Popupbox.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <materialDesign:DialogHost
        CloseOnClickAway="True"
        Identifier="RootDialog"
        SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid Background="{StaticResource QccCanvas}">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border
                Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource QccBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Width="30" Height="30" Background="Transparent" ClipToBounds="True" CornerRadius="7">
                            <Image Source="/Resources/MikaLogo.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock Margin="11,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource QccDisplayFont}" FontSize="17" FontWeight="SemiBold" Text="米卡" />
                        <TextBlock x:Name="txtAppVersion" Margin="14,1,0,0" VerticalAlignment="Center" Foreground="{StaticResource QccMuted}" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PopupBox
                            x:Name="pbQuietUpdate"
                            Width="104"
                            HorizontalAlignment="Center"
                            Opened="QuietUpdatePopup_Opened"
                            PlacementMode="BottomAndAlignRightEdges"
                            StaysOpen="True">
                            <materialDesign:PopupBox.ToggleContent>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="17" Height="17" Margin="0,0,7,0" Kind="CloudSyncOutline" />
                                    <TextBlock VerticalAlignment="Center" FontSize="13" Text="软件更新" />
                                </StackPanel>
                            </materialDesign:PopupBox.ToggleContent>
                            <Border Width="380" Padding="18" Background="White" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource QccDisplayFont}" FontSize="16" FontWeight="SemiBold" Text="软件更新" />
                                    <TextBlock Margin="0,4,0,14" Foreground="{StaticResource QccMuted}" FontSize="12" Text="官方 GUI 只用于发现版本，不会覆盖定制界面。" TextWrapping="Wrap" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="27" />
                                            <RowDefinition Height="27" />
                                            <RowDefinition Height="27" />
                                            <RowDefinition Height="27" />
                                            <RowDefinition Height="27" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource QccMuted}" Text="当前版本" />
                                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource QccMuted}" Text="官方最新" />
                                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource QccMuted}" Text="定制版最新" />
                                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource QccMuted}" Text="上次检查" />
                                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Foreground="{StaticResource QccMuted}" Text="上次成功" />
                                        <TextBlock Grid.Row="5" VerticalAlignment="Top" Margin="0,5,0,0" Foreground="{StaticResource QccMuted}" Text="检查状态" />
                                        <TextBlock x:Name="txtQuietUpdateCurrentVersion" Grid.Column="1" VerticalAlignment="Center" />
                                        <TextBlock x:Name="txtQuietUpdateOfficialVersion" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
                                        <TextBlock x:Name="txtQuietUpdateCustomVersion" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />
                                        <TextBlock x:Name="txtQuietUpdateLastAttempt" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" />
                                        <TextBlock x:Name="txtQuietUpdateLastSuccess" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" />
                                        <TextBlock x:Name="txtQuietUpdateStatus" Grid.Row="5" Grid.Column="1" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </Grid>
                                    <Button
                                        x:Name="btnQuietUpdateCheckNow"
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Right"
                                        Click="QuietUpdateCheckNow_Click"
                                        Content="立即检查"
                                        Style="{StaticResource QccCompactPrimaryButton}" />
                                </StackPanel>
                            </Border>
                        </materialDesign:PopupBox>
                        <Button x:Name="menuCheckUpdate" Width="128" Style="{StaticResource QccIconButton}" ToolTip="仅更新核心与 Geo 数据，不替换定制界面">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="17" Height="17" Margin="0,0,7,0" Kind="Update" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="检查内核更新" />
                            </StackPanel>
                        </Button>
                        <materialDesign:PopupBox Width="78" HorizontalAlignment="Center" PlacementMode="BottomAndAlignRightEdges">
                            <materialDesign:PopupBox.ToggleContent>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="17" Height="17" Margin="0,0,6,0" Kind="ThemeLightDark" />
                                    <TextBlock VerticalAlignment="Center" FontSize="13" Text="主题" />
                                </StackPanel>
                            </materialDesign:PopupBox.ToggleContent>
                            <Border Padding="8" Background="White" CornerRadius="8">
                                <ContentControl x:Name="pbTheme" />
                            </Border>
                        </materialDesign:PopupBox>
                        <Button x:Name="btnWindowMinimize" Style="{StaticResource QccIconButton}" Click="WindowMinimize_Click">
                            <materialDesign:PackIcon Width="17" Height="17" Kind="WindowMinimize" />
                        </Button>
                        <Button x:Name="btnWindowMaximize" Style="{StaticResource QccIconButton}" Click="WindowMaximize_Click">
                            <materialDesign:PackIcon Width="15" Height="15" Kind="WindowMaximize" />
                        </Button>
                        <Button x:Name="btnWindowClose" Style="{StaticResource QccIconButton}" Click="WindowClose_Click">
                            <materialDesign:PackIcon Width="17" Height="17" Kind="Close" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="174" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource QccBorder}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,12,0,0">
                            <Button x:Name="btnNavHome" Style="{StaticResource QccNavButtonActive}" Click="ShowProfiles_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="20" Height="20" Margin="2,0,12,0" Kind="Home" />
                                    <TextBlock VerticalAlignment="Center" Text="首页" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnNavNodes" Style="{StaticResource QccNavButton}" Click="ShowProfiles_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="20" Height="20" Margin="2,0,12,0" Kind="ViewGridOutline" />
                                    <TextBlock VerticalAlignment="Center" Text="节点" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnNavSubscription" Style="{StaticResource QccNavButton}" Click="ShowSubscription_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="20" Height="20" Margin="2,0,12,0" Kind="FileDocumentOutline" />
                                    <TextBlock VerticalAlignment="Center" Text="订阅" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnNavRouting" Style="{StaticResource QccNavButton}" Click="ShowRouting_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="20" Height="20" Margin="2,0,12,0" Kind="SourceBranch" />
                                    <TextBlock VerticalAlignment="Center" Text="路由" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnNavConnections" Style="{StaticResource QccNavButton}" Click="ShowConnections_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="20" Height="20" Margin="2,0,12,0" Kind="Web" />
                                    <TextBlock VerticalAlignment="Center" Text="连接" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnNavLogs" Style="{StaticResource QccNavButton}" Click="ShowLogs_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="20" Height="20" Margin="2,0,12,0" Kind="TextBoxOutline" />
                                    <TextBlock VerticalAlignment="Center" Text="日志" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnNavSettings" Style="{StaticResource QccNavButton}" Click="ShowSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="20" Height="20" Margin="2,0,12,0" Kind="CogOutline" />
                                    <TextBlock VerticalAlignment="Center" Text="设置" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="16,0,12,12">
                            <TextBlock Style="{StaticResource QccMutedText}" Text="核心与组件" />
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource QccMuted}" FontSize="12" Text="Xray / sing-box / mihomo" />
                            <Button x:Name="btnNewUpdate" Margin="-10,8,0,0" HorizontalAlignment="Left" Foreground="{StaticResource QccPrimary}" Background="Transparent" BorderThickness="0" Content="更新核心组件" Cursor="Hand" ToolTip="定制客户端仅通过 Quiet Control Center 完整包更新" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main workspace -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="rowConnectionSummary" Height="120" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="132" />
                    </Grid.RowDefinitions>

                    <!-- Connection summary -->
                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource QccBorder}" BorderThickness="0,0,0,1">
                        <Grid Margin="18,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="172" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="11" Foreground="{StaticResource QccMuted}" Text="当前节点" />
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="txtHeroNodeName"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        LineHeight="21"
                                        Style="{StaticResource QccHeading}"
                                        Text="{Binding ProfilesViewModel.SelectedProfile.Remarks, FallbackValue=尚未连接}"
                                        TextWrapping="Wrap"
                                        ToolTip="{Binding ProfilesViewModel.SelectedProfile.Remarks}" />
                                    <Border x:Name="borderHeroConnectionState" Grid.Column="1" Margin="8,1,0,0" Padding="7,2" VerticalAlignment="Top" Background="#FFF2F4F7" CornerRadius="8">
                                        <TextBlock x:Name="txtHeroConnectionState" Foreground="{StaticResource QccMuted}" FontSize="11" FontWeight="SemiBold" Text="未连接" />
                                    </Border>
                                </Grid>
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource QccMuted}" FontSize="11" Text="连接状态由当前活动配置实时同步" TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Column="1" Margin="10,0,12,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.15*" />
                                    <RowDefinition Height="1*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource QccCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="10,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtHeroProxySpeed" FontSize="12" Text="↑ 0.0 B/s  ↓ 0.0 B/s" TextTrimming="CharacterEllipsis" ToolTip="代理实时上传 / 下载" />
                                            <TextBlock Margin="0,1,0,0" FontSize="11" Style="{StaticResource QccMutedText}" Text="代理流量" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtHeroDirectSpeed" FontSize="12" Text="↑ 0.0 B/s  ↓ 0.0 B/s" TextTrimming="CharacterEllipsis" ToolTip="直连实时上传 / 下载" />
                                            <TextBlock Margin="0,1,0,0" FontSize="11" Style="{StaticResource QccMutedText}" Text="直连流量" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Style="{StaticResource QccCard}">
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"><TextBlock FontSize="11" Style="{StaticResource QccMutedText}" Text="延迟" /><TextBlock x:Name="txtHeroDelay" Margin="0,1,0,0" FontSize="12" Text="—" ToolTip="经当前代理到测速地址的每秒响应延迟" /></StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="11" Style="{StaticResource QccMutedText}" Text="抖动 / 丢包" /><TextBlock x:Name="txtHeroJitterLoss" Margin="0,1,0,0" FontSize="12" Text="— / —" ToolTip="最近 10 次应用层探测的抖动 / 超时比例" /></StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock FontSize="11" Style="{StaticResource QccMutedText}" Text="运行状态" /><TextBlock x:Name="txtHeroRunningStatus" Margin="0,1,0,0" FontSize="12" Text="未连接" TextWrapping="Wrap" /></StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="btnHeroSwitch" Height="34" Padding="12,0" FontSize="12" Style="{StaticResource QccPrimaryButton}" Click="ShowProfiles_Click">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="16" Height="16" Margin="0,0,7,0" Kind="SwapHorizontal" /><TextBlock VerticalAlignment="Center" Text="切换节点" /></StackPanel>
                                </Button>
                                <Button x:Name="btnDisconnect" Height="32" Margin="0,6,0,0" Padding="12,0" FontSize="12" Style="{StaticResource QccSecondaryButton}" Click="Disconnect_Click" ToolTip="停止当前代理核心；重新载入配置可再次连接">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="16" Height="16" Margin="0,0,7,0" Foreground="{StaticResource QccDanger}" Kind="Power" /><TextBlock VerticalAlignment="Center" Text="断开连接" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="gridMain" Grid.Row="1" Background="White">
                        <ContentControl x:Name="tabProfiles" />
                        <TabControl x:Name="tabMain" Visibility="Collapsed">
                            <TabItem x:Name="tabMsgView" Header="日志" />
                            <TabItem x:Name="tabClashProxies" Header="代理组" />
                            <TabItem x:Name="tabClashConnections" Header="活动连接" />
                        </TabControl>
                    </Grid>

                    <ContentControl x:Name="contentStatusBarView" Grid.Row="2" />
                </Grid>
            </Grid>

            <materialDesign:Snackbar x:Name="MainSnackbar" Grid.Row="1" MessageQueue="{materialDesign:MessageQueue}" />

            <!-- Command surface retained for compatibility with upstream ViewModel bindings. -->
            <Grid Visibility="Collapsed">
                <Menu>
                    <MenuItem x:Name="menuAddServerViaClipboard" /><MenuItem x:Name="menuAddServerViaScan" /><MenuItem x:Name="menuAddServerViaImage" />
                    <MenuItem x:Name="menuAddCustomServer" /><MenuItem x:Name="menuAddPolicyGroupServer" /><MenuItem x:Name="menuAddProxyChainServer" />
                    <MenuItem x:Name="menuAddVmessServer" /><MenuItem x:Name="menuAddVlessServer" /><MenuItem x:Name="menuAddShadowsocksServer" />
                    <MenuItem x:Name="menuAddTrojanServer" /><MenuItem x:Name="menuAddHysteria2Server" /><MenuItem x:Name="menuAddWireguardServer" />
                    <MenuItem x:Name="menuAddSocksServer" /><MenuItem x:Name="menuAddHttpServer" /><MenuItem x:Name="menuAddTuicServer" />
                    <MenuItem x:Name="menuAddAnytlsServer" /><MenuItem x:Name="menuAddNaiveServer" />
                    <MenuItem x:Name="menuSubSetting" /><MenuItem x:Name="menuSubUpdate" /><MenuItem x:Name="menuSubUpdateViaProxy" />
                    <MenuItem x:Name="menuSubGroupUpdate" /><MenuItem x:Name="menuSubGroupUpdateViaProxy" />
                    <MenuItem x:Name="menuOptionSetting" /><MenuItem x:Name="menuRoutingSetting" /><MenuItem x:Name="menuDNSSetting" />
                    <MenuItem x:Name="menuFullConfigTemplate" /><MenuItem x:Name="menuGlobalHotkeySetting" /><MenuItem x:Name="menuRebootAsAdmin" />
                    <MenuItem x:Name="menuSettingsSetUWP" /><MenuItem x:Name="menuClearServerStatistics" /><MenuItem x:Name="menuBackupAndRestore" />
                    <MenuItem x:Name="menuOpenTheFileLocation" /><MenuItem x:Name="menuRegionalPresetsDefault" /><MenuItem x:Name="menuRegionalPresetsRussia" />
                    <MenuItem x:Name="menuRegionalPresetsIran" /><MenuItem x:Name="menuReload" /><MenuItem x:Name="menuPromotion" /><MenuItem x:Name="menuClose" />
                    <MenuItem x:Name="menuHelp" />
                </Menu>
            </Grid>

            <!-- One-pixel outline keeps the window visible against light desktop backgrounds. -->
            <Border
                x:Name="windowOutline"
                Grid.RowSpan="2"
                Panel.ZIndex="1000"
                BorderBrush="#FFD8DCE2"
                BorderThickness="1"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True" />
        </Grid>
    </materialDesign:DialogHost>
</base:WindowBase>
