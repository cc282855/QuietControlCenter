<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.ProfilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:converters="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:local="clr-namespace:v2rayN.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="560"
    d:DesignWidth="1240"
    x:TypeArguments="vms:ProfilesViewModel"
    Background="{StaticResource QccSurface}"
    FontFamily="{StaticResource QccFont}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:DelayColorConverter x:Key="DelayColorConverter" />
        <local:ActiveNodeMarkerConverter x:Key="ActiveNodeMarkerConverter" />
        <local:DelayDisplayConverter x:Key="DelayDisplayConverter" />
        <local:SpeedDisplayConverter x:Key="SpeedDisplayConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search and filters -->
            <Border x:Name="borderProfileToolbar" Grid.Row="0" MinHeight="56" BorderBrush="{StaticResource QccBorder}" BorderThickness="0,0,1,1">
                <Grid Margin="10,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.65*" />
                        <ColumnDefinition Width="0.8*" MinWidth="148" MaxWidth="210" />
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="btnProfileColumns"
                        Width="36"
                        Height="34"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="选择节点列表字段"
                        Style="{StaticResource QccIconButton}"
                        ToolTip="显示或隐藏节点字段">
                        <materialDesign:PackIcon Width="19" Height="19" Kind="ViewColumnOutline" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="menuProfileColumns" Placement="Bottom">
                                <MenuItem Header="节点列表字段" IsEnabled="False" FontWeight="SemiBold" />
                                <Separator />
                                <MenuItem x:Name="menuColumnConfigType" Header="协议" IsCheckable="True" StaysOpenOnClick="True" />
                                <MenuItem x:Name="menuColumnRemarks" Header="节点名称" IsCheckable="True" StaysOpenOnClick="True" />
                                <MenuItem x:Name="menuColumnAddress" Header="地址" IsCheckable="True" StaysOpenOnClick="True" />
                                <MenuItem x:Name="menuColumnPort" Header="端口" IsCheckable="True" StaysOpenOnClick="True" />
                                <MenuItem x:Name="menuColumnNetwork" Header="传输" IsCheckable="True" StaysOpenOnClick="True" />
                                <MenuItem x:Name="menuColumnStreamSecurity" Header="安全" IsCheckable="True" StaysOpenOnClick="True" />
                                <MenuItem x:Name="menuColumnDelay" Header="延迟" IsCheckable="True" StaysOpenOnClick="True" />
                                <MenuItem x:Name="menuColumnSpeed" Header="速度" IsCheckable="True" StaysOpenOnClick="True" />
                                <Separator />
                                <MenuItem x:Name="menuColumnTodayUp" Header="今日上传" IsCheckable="True" StaysOpenOnClick="True" />
                                <MenuItem x:Name="menuColumnTodayDown" Header="今日下载" IsCheckable="True" StaysOpenOnClick="True" />
                                <MenuItem x:Name="menuColumnTotalUp" Header="累计上传" IsCheckable="True" StaysOpenOnClick="True" />
                                <MenuItem x:Name="menuColumnTotalDown" Header="累计下载" IsCheckable="True" StaysOpenOnClick="True" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <TextBox
                        x:Name="txtServerFilter"
                        Grid.Column="1"
                        MinHeight="34"
                        Padding="12,8"
                        VerticalContentAlignment="Center"
                        FontSize="{DynamicResource QccFontBody}"
                        materialDesign:HintAssist.Hint="搜索节点（名称、备注、地址）"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    <ComboBox
                        x:Name="lstCountry"
                        Grid.Column="2"
                        MinHeight="34"
                        Margin="10,0,0,0"
                        Padding="10,4"
                        AutomationProperties.Name="国家/地区"
                        DisplayMemberPath="DisplayName"
                        FontSize="{DynamicResource QccFontBody}"
                        ItemsSource="{Binding CountryItems}"
                        SelectedValue="{Binding SelectedCountryCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Code"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                    <ComboBox
                        x:Name="lstGroup"
                        Grid.Column="3"
                        MinHeight="34"
                        Margin="10,0,0,0"
                        Padding="10,4"
                        AutomationProperties.Name="订阅分组"
                        DisplayMemberPath="Remarks"
                        FontSize="{DynamicResource QccFontBody}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                    <Button x:Name="btnEditSub" Grid.Column="4" Margin="6,0,0,0" AutomationProperties.Name="编辑当前订阅" Style="{StaticResource QccIconButton}" ToolTip="编辑订阅">
                        <materialDesign:PackIcon Width="19" Height="19" Kind="PlaylistEdit" />
                    </Button>
                    <Button x:Name="btnAddSub" Grid.Column="5" Height="34" Margin="6,0,0,0" Padding="10,0" AutomationProperties.Name="添加订阅" Style="{StaticResource QccPrimaryButton}" ToolTip="添加订阅">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="17" Height="17" Margin="0,0,6,0" Kind="PlaylistPlus" />
                            <TextBlock VerticalAlignment="Center" Text="添加订阅" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnAutofitColumnWidth" Grid.Column="6" AutomationProperties.Name="自动调整节点列表列宽" Style="{StaticResource QccIconButton}" ToolTip="自动调整列宽">
                        <materialDesign:PackIcon Width="19" Height="19" Kind="TableColumnWidth" />
                    </Button>
                </Grid>
            </Border>

            <!-- Node table -->
            <DataGrid
                x:Name="lstProfiles"
                Grid.Row="1"
                AutoGenerateColumns="False"
                Background="{StaticResource QccSurface}"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="True"
                CanUserResizeRows="False"
                CanUserSortColumns="False"
                EnableRowVirtualization="True"
                FontSize="{DynamicResource QccFontBody}"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                HorizontalGridLinesBrush="{StaticResource QccBorder}"
                IsReadOnly="True"
                RowHeaderWidth="0"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.PanningMode="Both"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Style="{StaticResource MaterialDesignDataGrid}"
                VerticalGridLinesBrush="Transparent">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="Background" Value="{StaticResource QccSurfaceRaised}" />
                        <Setter Property="Foreground" Value="{StaticResource QccMuted}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="8,0" />
                        <EventSetter Event="Click" Handler="LstProfiles_ColumnHeader_Click" />
                    </Style>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="Background" Value="{StaticResource QccSurface}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <EventSetter Event="MouseDoubleClick" Handler="LstProfiles_MouseDoubleClick" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource QccPrimarySoft}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource QccPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.ContextMenu>
                    <ContextMenu Style="{StaticResource DefContextMenu}">
                        <MenuItem x:Name="menuSetDefaultServer" Header="设为活动节点" />
                        <Separator />
                        <MenuItem Header="测试节点">
                            <MenuItem x:Name="menuMixedTestServer" Header="综合测试" />
                            <MenuItem x:Name="menuTcpingServer" Header="测试 TCP 延迟" />
                            <MenuItem x:Name="menuRealPingServer" Header="测试真实延迟" />
                            <MenuItem x:Name="menuUdpTestServer" Header="测试 UDP" />
                            <MenuItem x:Name="menuSpeedServer" Header="测试速度" />
                            <Separator />
                            <MenuItem x:Name="menuSortServerResult" Header="按测试结果排序" />
                        </MenuItem>
                        <MenuItem Header="编辑与移动">
                            <MenuItem x:Name="menuEditServer" Header="编辑节点" />
                            <MenuItem x:Name="menuCopyServer" Header="复制节点" />
                            <MenuItem x:Name="menuMoveToGroup">
                                <MenuItem.Header>
                                    <DockPanel>
                                        <ComboBox x:Name="cmbMoveToGroup" MinWidth="180" AutomationProperties.Name="移动节点到分组" DisplayMemberPath="Remarks" materialDesign:HintAssist.Hint="移动到分组" />
                                    </DockPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Header="调整顺序">
                                <MenuItem x:Name="menuMoveTop" Header="移到顶部" />
                                <MenuItem x:Name="menuMoveUp" Header="上移" />
                                <MenuItem x:Name="menuMoveDown" Header="下移" />
                                <MenuItem x:Name="menuMoveBottom" Header="移到底部" />
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="分享与导出">
                            <MenuItem x:Name="menuShareServer" Header="分享节点" />
                            <MenuItem x:Name="menuExport2ClientConfig" Header="导出客户端配置" />
                            <MenuItem x:Name="menuExport2ClientConfigClipboard" Header="复制客户端配置" />
                            <MenuItem x:Name="menuExport2ShareUrl" Header="复制分享链接" />
                            <MenuItem x:Name="menuExport2ShareUrlBase64" Header="复制 Base64 链接" />
                            <MenuItem x:Name="menuExport2InnerUri" Header="复制内部链接" />
                        </MenuItem>
                        <MenuItem Header="批量工具">
                            <MenuItem x:Name="menuSelectAll" Header="全选" />
                            <MenuItem x:Name="menuGenGroupAllServer" Header="全部节点" />
                            <MenuItem x:Name="menuGenGroupRegionServer" Header="按地区" />
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="menuRemoveServer" Foreground="{StaticResource QccDanger}" Header="删除节点" />
                        <MenuItem x:Name="menuRemoveDuplicateServer" Foreground="{StaticResource QccDanger}" Header="删除重复节点" />
                        <MenuItem x:Name="menuRemoveInvalidServerResult" Foreground="{StaticResource QccDanger}" Header="删除无效节点" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <base:MyDGTextColumn
                        x:Name="colActiveMarker"
                        Width="30"
                        MinWidth="30"
                        Binding="{Binding IsActive, Converter={StaticResource ActiveNodeMarkerConverter}}"
                        CanUserReorder="False"
                        CanUserResize="False"
                        ExName="ActiveMarker"
                        Header="">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource QccDanger}" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="TextAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </base:MyDGTextColumn>
                    <base:MyDGTextColumn x:Name="colRemarks" Width="1.55*" MinWidth="170" Binding="{Binding Remarks}" ExName="Remarks" Header="节点名称" />
                    <base:MyDGTextColumn x:Name="colConfigType" Width="0.9*" MinWidth="108" Binding="{Binding ConfigType}" ExName="ConfigType" Header="协议" />
                    <base:MyDGTextColumn x:Name="colSubRemarks" Width="1.1*" MinWidth="120" Binding="{Binding SubRemarks}" ExName="SubRemarks" Header="分组" />
                    <base:MyDGTextColumn x:Name="colNetwork" Width="0.9*" MinWidth="86" Binding="{Binding Network}" ExName="Network" Header="传输" />
                    <base:MyDGTextColumn x:Name="colDelay" Width="0.9*" MinWidth="86" Binding="{Binding Delay, Converter={StaticResource DelayDisplayConverter}}" ExName="DelayVal" Header="延迟" SortMemberPath="Delay">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Delay, Converter={StaticResource DelayColorConverter}}" /></Style>
                        </DataGridTextColumn.ElementStyle>
                    </base:MyDGTextColumn>
                    <base:MyDGTextColumn x:Name="colSpeed" Width="1*" MinWidth="108" Binding="{Binding SpeedVal, Converter={StaticResource SpeedDisplayConverter}}" ExName="SpeedVal" Header="速度" SortMemberPath="Speed" />
                    <base:MyDGTextColumn x:Name="colAddress" Width="1.25*" MinWidth="168" Binding="{Binding Address}" ExName="Address" Header="地址" />
                    <base:MyDGTextColumn x:Name="colPort" Width="70" MinWidth="68" Binding="{Binding Port}" ExName="Port" Header="端口" />
                    <base:MyDGTextColumn x:Name="colSecurity" Width="90" MinWidth="86" Binding="{Binding StreamSecurity}" ExName="StreamSecurity" Header="安全" />
                    <base:MyDGTextColumn x:Name="colTodayUp" Width="104" MinWidth="96" Visibility="Collapsed" Binding="{Binding TodayUp}" ExName="TodayUp" Header="今日上传" />
                    <base:MyDGTextColumn x:Name="colTodayDown" Width="104" MinWidth="96" Visibility="Collapsed" Binding="{Binding TodayDown}" ExName="TodayDown" Header="今日下载" />
                    <base:MyDGTextColumn x:Name="colTotalUp" Width="104" MinWidth="96" Visibility="Collapsed" Binding="{Binding TotalUp}" ExName="TotalUp" Header="累计上传" />
                    <base:MyDGTextColumn x:Name="colTotalDown" Width="104" MinWidth="96" Visibility="Collapsed" Binding="{Binding TotalDown}" ExName="TotalDown" Header="累计下载" />
                    <base:MyDGTextColumn x:Name="colIpInfo" Visibility="Collapsed" Binding="{Binding IpInfo}" ExName="IpInfo" Header="IP 信息" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Panel.ZIndex="2" Background="{StaticResource QccSurface}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=lstProfiles, Path=HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="54" Height="54" HorizontalAlignment="Center" Background="{StaticResource QccPrimarySoft}" CornerRadius="18">
                        <materialDesign:PackIcon Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource QccPrimary}" Kind="ServerNetworkOff" />
                    </Border>
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="{DynamicResource QccFontLarge}" FontWeight="SemiBold" Text="当前没有匹配的节点" />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{StaticResource QccMuted}" Text="可清空搜索、切换地区或订阅分组；尚未添加订阅时可直接添加。" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="btnEmptyAddSub" Margin="0,18,0,0" HorizontalAlignment="Center" Style="{StaticResource QccPrimaryButton}" Content="添加订阅" />
                </StackPanel>
            </Border>

            <Border x:Name="borderProfileTestActions" Grid.Row="2" MinHeight="36" BorderBrush="{StaticResource QccBorder}" BorderThickness="0,1,1,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource QccMuted}" FontSize="{DynamicResource QccFontBody}" Text="单击选择节点；双击设为活动节点；右键查看更多操作；红色 ★ 表示当前活动节点" TextTrimming="CharacterEllipsis" ToolTip="单击选择节点；双击设为活动节点；右键查看更多操作；红色 ★ 表示当前活动节点" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnFastRealPing" VerticalAlignment="Center" AutomationProperties.Name="测试当前筛选结果中全部节点的延迟" Style="{StaticResource QccSecondaryButton}" ToolTip="测试当前筛选结果中的全部节点">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="16" Height="16" Margin="0,0,7,0" Kind="TimerOutline" /><TextBlock VerticalAlignment="Center" Text="测延迟" /></StackPanel>
                        </Button>
                        <Button x:Name="btnMixedTest" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="测试当前筛选结果中全部节点的延迟和速度" Style="{StaticResource QccSecondaryButton}" ToolTip="测试当前筛选结果中的全部节点；速度测试会产生网络流量">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="16" Height="16" Margin="0,0,7,0" Kind="Speedometer" /><TextBlock VerticalAlignment="Center" Text="延迟+速度" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</reactiveui:ReactiveUserControl>
