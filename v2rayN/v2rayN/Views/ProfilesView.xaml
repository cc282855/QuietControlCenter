<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.ProfilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="560"
    d:DesignWidth="1240"
    x:TypeArguments="vms:ProfilesViewModel"
    Background="White"
    FontFamily="{StaticResource QccFont}"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="312" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <!-- Search and filters -->
            <Border Grid.Row="0" BorderBrush="{StaticResource QccBorder}" BorderThickness="0,0,1,1">
                <Grid Margin="18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="txtServerFilter"
                        Height="40"
                        Padding="12,8"
                        VerticalContentAlignment="Center"
                        materialDesign:HintAssist.Hint="搜索节点（名称、备注、地址）"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    <ComboBox
                        x:Name="lstGroup"
                        Grid.Column="1"
                        Height="40"
                        Margin="12,0,0,0"
                        Padding="10,4"
                        DisplayMemberPath="Remarks"
                        materialDesign:HintAssist.Hint="所有分组"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                    <Button x:Name="btnEditSub" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource QccIconButton}" ToolTip="编辑订阅">
                        <materialDesign:PackIcon Width="19" Height="19" Kind="PlaylistEdit" />
                    </Button>
                    <Button x:Name="btnAddSub" Grid.Column="3" Style="{StaticResource QccIconButton}" ToolTip="添加订阅">
                        <materialDesign:PackIcon Width="19" Height="19" Kind="PlaylistPlus" />
                    </Button>
                    <Button x:Name="btnAutofitColumnWidth" Grid.Column="4" Style="{StaticResource QccIconButton}" ToolTip="自动调整列宽">
                        <materialDesign:PackIcon Width="19" Height="19" Kind="TableColumnWidth" />
                    </Button>
                </Grid>
            </Border>

            <!-- Node table -->
            <DataGrid
                x:Name="lstProfiles"
                Grid.Row="1"
                AutoGenerateColumns="False"
                Background="White"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="True"
                CanUserResizeRows="False"
                CanUserSortColumns="False"
                ColumnHeaderHeight="38"
                EnableRowVirtualization="True"
                FontSize="13"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                HorizontalGridLinesBrush="{StaticResource QccBorder}"
                IsReadOnly="True"
                RowHeaderWidth="0"
                RowHeight="39"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Style="{StaticResource MaterialDesignDataGrid}"
                VerticalGridLinesBrush="Transparent">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#FFFBFCFE" />
                        <Setter Property="Foreground" Value="{StaticResource QccMuted}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="12,0" />
                        <EventSetter Event="Click" Handler="LstProfiles_ColumnHeader_Click" />
                    </Style>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                        <EventSetter Event="MouseDoubleClick" Handler="LstProfiles_MouseDoubleClick" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource QccPrimarySoft}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource QccPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.ContextMenu>
                    <ContextMenu Style="{StaticResource DefContextMenu}">
                        <MenuItem x:Name="menuSetDefaultServer" Header="设为活动节点" />
                        <MenuItem x:Name="menuEditServer" Header="编辑节点" />
                        <MenuItem x:Name="menuCopyServer" Header="复制节点" />
                        <MenuItem x:Name="menuRemoveServer" Header="删除节点" />
                        <Separator />
                        <MenuItem x:Name="menuMixedTestServer" Header="综合测试" />
                        <MenuItem x:Name="menuTcpingServer" Header="测试 TCP 延迟" />
                        <MenuItem x:Name="menuRealPingServer" Header="测试真实延迟" />
                        <MenuItem x:Name="menuUdpTestServer" Header="测试 UDP" />
                        <MenuItem x:Name="menuSpeedServer" Header="测试速度" />
                        <MenuItem x:Name="menuSortServerResult" Header="按测试结果排序" />
                        <Separator />
                        <MenuItem x:Name="menuMoveToGroup" Header="移动到分组">
                            <MenuItem.HeaderTemplate>
                                <DataTemplate>
                                    <ComboBox x:Name="cmbMoveToGroup" MinWidth="180" DisplayMemberPath="Remarks" />
                                </DataTemplate>
                            </MenuItem.HeaderTemplate>
                        </MenuItem>
                        <MenuItem Header="调整顺序">
                            <MenuItem x:Name="menuMoveTop" Header="移到顶部" />
                            <MenuItem x:Name="menuMoveUp" Header="上移" />
                            <MenuItem x:Name="menuMoveDown" Header="下移" />
                            <MenuItem x:Name="menuMoveBottom" Header="移到底部" />
                        </MenuItem>
                        <MenuItem x:Name="menuSelectAll" Header="全选" />
                        <Separator />
                        <MenuItem x:Name="menuShareServer" Header="分享节点" />
                        <MenuItem Header="导出">
                            <MenuItem x:Name="menuExport2ClientConfig" Header="导出客户端配置" />
                            <MenuItem x:Name="menuExport2ClientConfigClipboard" Header="复制客户端配置" />
                            <MenuItem x:Name="menuExport2ShareUrl" Header="复制分享链接" />
                            <MenuItem x:Name="menuExport2ShareUrlBase64" Header="复制 Base64 链接" />
                            <MenuItem x:Name="menuExport2InnerUri" Header="复制内部链接" />
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="menuRemoveDuplicateServer" Header="删除重复节点" />
                        <MenuItem x:Name="menuRemoveInvalidServerResult" Header="删除无效节点" />
                        <MenuItem Header="生成策略组">
                            <MenuItem x:Name="menuGenGroupAllServer" Header="全部节点" />
                            <MenuItem x:Name="menuGenGroupRegionServer" Header="按地区" />
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <base:MyDGTextColumn Width="1.55*" Binding="{Binding Remarks}" ExName="Remarks" Header="节点名称" />
                    <base:MyDGTextColumn Width="0.8*" Binding="{Binding ConfigType}" ExName="ConfigType" Header="协议" />
                    <base:MyDGTextColumn Width="1.1*" Binding="{Binding SubRemarks}" ExName="SubRemarks" Header="分组" />
                    <base:MyDGTextColumn Width="0.9*" Binding="{Binding Network}" ExName="Network" Header="传输" />
                    <base:MyDGTextColumn Width="0.9*" Binding="{Binding DelayVal}" ExName="DelayVal" Header="延迟" SortMemberPath="Delay">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Delay, Converter={StaticResource DelayColorConverter}}" /></Style>
                        </DataGridTextColumn.ElementStyle>
                    </base:MyDGTextColumn>
                    <base:MyDGTextColumn Width="1*" Binding="{Binding SpeedVal}" ExName="SpeedVal" Header="速度" />
                    <base:MyDGTextColumn Width="1.25*" Binding="{Binding Address}" ExName="Address" Header="地址" />
                    <base:MyDGTextColumn Width="70" Binding="{Binding Port}" ExName="Port" Header="端口" />
                    <base:MyDGTextColumn Width="90" Binding="{Binding StreamSecurity}" ExName="StreamSecurity" Header="安全" />
                    <base:MyDGTextColumn x:Name="colTodayUp" Visibility="Collapsed" Binding="{Binding TodayUp}" ExName="TodayUp" Header="今日上传" />
                    <base:MyDGTextColumn x:Name="colTodayDown" Visibility="Collapsed" Binding="{Binding TodayDown}" ExName="TodayDown" Header="今日下载" />
                    <base:MyDGTextColumn x:Name="colTotalUp" Visibility="Collapsed" Binding="{Binding TotalUp}" ExName="TotalUp" Header="累计上传" />
                    <base:MyDGTextColumn x:Name="colTotalDown" Visibility="Collapsed" Binding="{Binding TotalDown}" ExName="TotalDown" Header="累计下载" />
                    <base:MyDGTextColumn x:Name="colIpInfo" Visibility="Collapsed" Binding="{Binding IpInfo}" ExName="IpInfo" Header="IP 信息" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" BorderBrush="{StaticResource QccBorder}" BorderThickness="0,1,1,0">
                <Grid Margin="18,0">
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource QccMuted}" FontSize="12" Text="选择节点后可在右侧查看详情；双击可按当前偏好激活或编辑" />
                    <Button x:Name="btnFastRealPing" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource QccSecondaryButton}">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Width="16" Height="16" Margin="0,0,7,0" Kind="Speedometer" /><TextBlock VerticalAlignment="Center" Text="立即测速" /></StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Selected node inspector -->
        <Border Grid.Column="1" Background="#FFFCFDFE" BorderBrush="{StaticResource QccBorder}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Padding="18,16" BorderBrush="{StaticResource QccBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="节点详情" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource QccIconButton}" ToolTip="收藏"><materialDesign:PackIcon Width="18" Height="18" Kind="StarOutline" /></Button>
                            <Button Style="{StaticResource QccIconButton}" ToolTip="更多"><materialDesign:PackIcon Width="18" Height="18" Kind="DotsVertical" /></Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,18,18,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource QccHeading}" FontSize="20" Text="{Binding SelectedProfile.Remarks, FallbackValue=请选择节点}" TextTrimming="CharacterEllipsis" MaxWidth="205" />
                            <Border Margin="8,1,0,0" Padding="8,3" VerticalAlignment="Top" Background="#FFE7F7EC" CornerRadius="8">
                                <TextBlock Foreground="{StaticResource QccSuccess}" FontSize="11" Text="可用" />
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" />
                                <RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource QccMutedText}" Text="协议" /><TextBlock Grid.Column="1" Text="{Binding SelectedProfile.ConfigType, FallbackValue=—}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource QccMutedText}" Text="传输协议" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProfile.Network, FallbackValue=—}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource QccMutedText}" Text="安全" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProfile.StreamSecurity, FallbackValue=—}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource QccMutedText}" Text="地址" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProfile.Address, FallbackValue=—}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="4" Style="{StaticResource QccMutedText}" Text="端口" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProfile.Port, FallbackValue=—}" />
                            <TextBlock Grid.Row="5" Style="{StaticResource QccMutedText}" Text="延迟" /><TextBlock Grid.Row="5" Grid.Column="1" Foreground="{StaticResource QccSuccess}" Text="{Binding SelectedProfile.DelayVal, FallbackValue=未测试}" />
                            <TextBlock Grid.Row="6" Style="{StaticResource QccMutedText}" Text="速度" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedProfile.SpeedVal, FallbackValue=未测试}" />
                            <TextBlock Grid.Row="7" Style="{StaticResource QccMutedText}" Text="订阅" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedProfile.SubRemarks, FallbackValue=本地节点}" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Separator Margin="0,12" Style="{StaticResource QccDivider}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="节点操作" />
                        <UniformGrid Margin="0,12,0,0" Columns="2" Rows="3">
                            <Button x:Name="btnDetailPing" Margin="0,0,6,8" Style="{StaticResource QccSecondaryButton}" Content="测试延迟" />
                            <Button x:Name="btnDetailSpeed" Margin="6,0,0,8" Style="{StaticResource QccSecondaryButton}" Content="测试速度" />
                            <Button x:Name="btnDetailCopy" Margin="0,0,6,8" Style="{StaticResource QccSecondaryButton}" Content="复制节点" />
                            <Button x:Name="btnDetailEdit" Margin="6,0,0,8" Style="{StaticResource QccSecondaryButton}" Content="编辑节点" />
                            <Button x:Name="btnDetailDelete" Margin="0,0,6,0" Foreground="{StaticResource QccDanger}" Style="{StaticResource QccSecondaryButton}" Content="删除节点" />
                            <Button x:Name="btnDetailActivate" Margin="6,0,0,0" Style="{StaticResource QccPrimaryButton}" Content="设为活动" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="18,12" BorderBrush="{StaticResource QccBorder}" BorderThickness="0,1,0,0">
                    <TextBlock Foreground="{StaticResource QccMuted}" FontSize="12" Text="右键节点可访问移动、导出和批量操作" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</reactiveui:ReactiveUserControl>
